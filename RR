local NittyFolder = workspace:WaitForChild("Nittys")

local NittyESPEnabled = false
local ESPCache = {}
local NPCConnections = {}

local NittyConfig = {
    BoxColor = Color3.fromRGB(255,255,255),
    StrokeColor = Color3.fromRGB(0,0,0),
    HealthBarWidth = 3,
    Thickness = 1.5,
    StrokeThickness = 3,
    MaxDistance = 2000
}

local function NittyNewLine(thickness, color)
    local line = Drawing.new("Line")
    line.Thickness = thickness
    line.Color = color
    line.Transparency = 1
    line.Visible = false
    return line
end

local function HideESP(cache)
    for _,v in pairs(cache.Box) do
        v.Visible = false
    end
    for _,v in pairs(cache.Stroke) do
        v.Visible = false
    end
    cache.Health.Visible = false
    cache.HealthOutline.Visible = false
    cache.Name.Visible = false
end

local function RemoveESP(model)
    local cache = ESPCache[model]
    if not cache then return end
    if cache.Connection then
        cache.Connection:Disconnect()
    end
    for _,v in pairs(cache.Box) do v:Remove() end
    for _,v in pairs(cache.Stroke) do v:Remove() end
    cache.Health:Remove()
    cache.HealthOutline:Remove()
    cache.Name:Remove()
    ESPCache[model] = nil
end

local function CreateESP(model)
    if ESPCache[model] then return end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    local head = model:FindFirstChild("Head")

    if not humanoid or not root or not head then return end

    local Stroke = {
        Top = NittyNewLine(NittyConfig.StrokeThickness, NittyConfig.StrokeColor),
        Bottom = NittyNewLine(NittyConfig.StrokeThickness, NittyConfig.StrokeColor),
        Left = NittyNewLine(NittyConfig.StrokeThickness, NittyConfig.StrokeColor),
        Right = NittyNewLine(NittyConfig.StrokeThickness, NittyConfig.StrokeColor)
    }

    local Box = {
        Top = NittyNewLine(NittyConfig.Thickness, NittyConfig.BoxColor),
        Bottom = NittyNewLine(NittyConfig.Thickness, NittyConfig.BoxColor),
        Left = NittyNewLine(NittyConfig.Thickness, NittyConfig.BoxColor),
        Right = NittyNewLine(NittyConfig.Thickness, NittyConfig.BoxColor)
    }

    local HealthOutline = NittyNewLine(5, Color3.fromRGB(0,0,0))
    HealthOutline.Transparency = 0.4

    local Health = NittyNewLine(3, Color3.fromRGB(0,255,0))

    local Name = Drawing.new("Text")
    Name.Size = 13
    Name.Center = true
    Name.Outline = true
    Name.Font = 2
    Name.Color = Color3.fromRGB(255,255,255)
    Name.Text = "Nitty"
    Name.Visible = false

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not NittyESPEnabled then
            HideESP(ESPCache[model])
            return
        end

        if not model.Parent or humanoid.Health <= 0 then
            HideESP(ESPCache[model])
            return
        end

        local distance = (Camera.CFrame.Position - root.Position).Magnitude
        if distance > NittyConfig.MaxDistance then
            HideESP(ESPCache[model])
            return
        end

        local headPos, headVisible = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
        local rootPos, rootVisible = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

        if not headVisible or not rootVisible or headPos.Z < 0 then
            HideESP(ESPCache[model])
            return
        end

        local height = math.abs(rootPos.Y - headPos.Y)
        local width = height * 0.6

        local left = headPos.X - width/2
        local right = headPos.X + width/2
        local top = headPos.Y
        local bottom = rootPos.Y

        Stroke.Top.From = Vector2.new(left, top);    Stroke.Top.To = Vector2.new(right, top)
        Stroke.Bottom.From = Vector2.new(left, bottom); Stroke.Bottom.To = Vector2.new(right, bottom)
        Stroke.Left.From = Vector2.new(left, top);   Stroke.Left.To = Vector2.new(left, bottom)
        Stroke.Right.From = Vector2.new(right, top); Stroke.Right.To = Vector2.new(right, bottom)

        Box.Top.From = Vector2.new(left, top);    Box.Top.To = Vector2.new(right, top)
        Box.Bottom.From = Vector2.new(left, bottom); Box.Bottom.To = Vector2.new(right, bottom)
        Box.Left.From = Vector2.new(left, top);   Box.Left.To = Vector2.new(left, bottom)
        Box.Right.From = Vector2.new(right, top); Box.Right.To = Vector2.new(right, bottom)

        for _,v in pairs(Stroke) do v.Visible = true end
        for _,v in pairs(Box) do v.Visible = true end

        local healthPercent = humanoid.Health / humanoid.MaxHealth
        local barHeight = height * healthPercent
        local healthX = left - 6

        HealthOutline.From = Vector2.new(healthX, top)
        HealthOutline.To = Vector2.new(healthX, bottom)
        HealthOutline.Visible = true

        Health.From = Vector2.new(healthX, bottom)
        Health.To = Vector2.new(healthX, bottom - barHeight)
        Health.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
        Health.Visible = true

        Name.Position = Vector2.new(headPos.X, top - 14)
        Name.Visible = true
    end)

    ESPCache[model] = {
        Stroke = Stroke,
        Box = Box,
        Health = Health,
        HealthOutline = HealthOutline,
        Name = Name,
        Connection = connection
    }
end

local function EnableESP()
    for _,npc in ipairs(NittyFolder:GetChildren()) do
        if npc:IsA("Model") and string.match(npc.Name, "^Nitty") then
            CreateESP(npc)
        end
    end

    NPCConnections.Added = NittyFolder.ChildAdded:Connect(function(obj)
        task.wait(0.1)
        if obj:IsA("Model") and string.match(obj.Name, "^Nitty") then
            CreateESP(obj)
        end
    end)

    NPCConnections.Removed = NittyFolder.ChildRemoved:Connect(function(obj)
        RemoveESP(obj)
    end)
end

local function DisableESP()
    for _,connection in pairs(NPCConnections) do
        connection:Disconnect()
    end
    table.clear(NPCConnections)
    for model,_ in pairs(ESPCache) do
        RemoveESP(model)
    end
end

