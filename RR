local function NewLine(thickness, color)
    local line = Drawing.new("Line")
    line.Thickness = thickness or Config.Thickness
    line.Color = color or Color3.fromRGB(255, 255, 255)
    line.Transparency = 1
    line.Visible = false
    return line
end

local function HideAll(sL, bL, hBg, hSegs, nameLabel, levelLabel, xpLabel)
    for _, l in pairs(sL) do l.Visible = false end
    for _, l in pairs(bL) do l.Visible = false end
    for _, s in ipairs(hSegs) do s.Visible = false end
    hBg.Visible = false
    nameLabel.Visible = false
    levelLabel.Visible = false
    xpLabel.Visible = false
end

local function SetupESP(plr)
    if plr == LocalPlayer then return end

    local sL = {
        Top = NewLine(Config.StrokeThickness, Color3.fromRGB(0,0,0)),
        Right = NewLine(Config.StrokeThickness, Color3.fromRGB(0,0,0)),
        Bottom = NewLine(Config.StrokeThickness, Color3.fromRGB(0,0,0)),
        Left = NewLine(Config.StrokeThickness, Color3.fromRGB(0,0,0)),
    }
    for _, l in pairs(sL) do l.Transparency = 0.35 end

    local bL = {
        Top = NewLine(nil, Config.BoxColor),
        Right = NewLine(nil, Config.BoxColor),
        Bottom = NewLine(nil, Config.BoxColor),
        Left = NewLine(nil, Config.BoxColor),
    }

    local hBg = NewLine(5.5, Color3.fromRGB(0, 0, 0))
    hBg.Transparency = 0.35

    local SEGS = 20
    local hSegs = {}
    for i = 1, SEGS do
        local t = (i - 1) / (SEGS - 1)
        local r, g
        if t <= 0.5 then
            r = 255; g = math.floor(t / 0.5 * 255)
        else
            r = math.floor((1 - (t - 0.5) / 0.5) * 255); g = 255
        end
        hSegs[i] = NewLine(3.4, Color3.fromRGB(r, g, 0))
    end

    local nameLabel = Drawing.new("Text")
    nameLabel.Text = plr.Name
    nameLabel.Size = 13
    nameLabel.Center = true
    nameLabel.Outline = true
    nameLabel.OutlineColor = Color3.fromRGB(0,0,0)
    nameLabel.Color = Color3.fromRGB(255,255,255)

    local levelLabel = Drawing.new("Text")
    levelLabel.Size = 11; levelLabel.Center = true; levelLabel.Outline = true
    levelLabel.OutlineColor = Color3.fromRGB(0,0,0)
    levelLabel.Color = Color3.fromRGB(180,220,255)

    local xpLabel = Drawing.new("Text")
    xpLabel.Size = 11; xpLabel.Center = true; xpLabel.Outline = true
    xpLabel.OutlineColor = Color3.fromRGB(0,0,0)
    xpLabel.Color = Color3.fromRGB(140,255,180)

    local function FindVal(folder, ...)
        for _, name in ipairs({...}) do
            local v = folder:FindFirstChild(name)
            if v then return v end
        end
    end

    local function GetStats()
        local folder = plr:FindFirstChild("Stats") or plr:FindFirstChild("Stat") or plr:FindFirstChild("leaderstats")
        if not folder then return nil, nil end
        local lvl = FindVal(folder, "Level","level","LVL","lvl")
        local xp = FindVal(folder, "XP","Xp","xp","EXP","Exp","exp")
        return lvl, xp
    end

    local function Cleanup()
        for _, l in pairs(sL) do l:Remove() end
        for _, l in pairs(bL) do l:Remove() end
        for _, s in ipairs(hSegs) do s:Remove() end
        hBg:Remove()
        nameLabel:Remove()
        levelLabel:Remove()
        xpLabel:Remove()
    end

    local conn = RunService.RenderStepped:Connect(function()
        if not (Config.BoxESP or Config.HealthbarESP or Config.NameESP or Config.LevelESP or Config.XpESP) then
            HideAll(sL, bL, hBg, hSegs, nameLabel, levelLabel, xpLabel)
            return
        end

        local char = plr.Character
        if not char or not char:FindFirstChild("Head") or not char:FindFirstChild("HumanoidRootPart") then
            HideAll(sL, bL, hBg, hSegs, nameLabel, levelLabel, xpLabel) return
        end

        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then HideAll(sL, bL, hBg, hSegs, nameLabel, levelLabel, xpLabel) return end

        local root = char.HumanoidRootPart
        if (root.Position - Camera.CFrame.Position).Magnitude > Config.MaxDistance then
            HideAll(sL, bL, hBg, hSegs, nameLabel, levelLabel, xpLabel) return
        end

        local headScreen, onHead = Camera:WorldToViewportPoint(char.Head.Position + Vector3.new(0,0.5,0))
        local feetScreen, onFeet = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

        if not onHead or not onFeet or headScreen.Z < 0 then
            HideAll(sL, bL, hBg, hSegs, nameLabel, levelLabel, xpLabel) return
        end

        local bH = math.abs(feetScreen.Y - headScreen.Y)
        local bW = bH * 0.6
        local cx = headScreen.X
        local barX = cx - bW/2 - 12


        if Config.BoxESP then
            local so = Config.StrokeThickness / 2
            sL.Top.From = Vector2.new(cx - bW/2 - so, headScreen.Y); sL.Top.To = Vector2.new(cx + bW/2 + so, headScreen.Y)
            sL.Right.From = Vector2.new(cx + bW/2 + so, headScreen.Y); sL.Right.To = Vector2.new(cx + bW/2 + so, feetScreen.Y)
            sL.Bottom.From = Vector2.new(cx + bW/2 + so, feetScreen.Y); sL.Bottom.To = Vector2.new(cx - bW/2 - so, feetScreen.Y)
            sL.Left.From = Vector2.new(cx - bW/2 - so, feetScreen.Y); sL.Left.To = Vector2.new(cx - bW/2 - so, headScreen.Y)
            for _, l in pairs(sL) do l.Visible = true end

            bL.Top.From = Vector2.new(cx - bW/2, headScreen.Y); bL.Top.To = Vector2.new(cx + bW/2, headScreen.Y)
            bL.Right.From = Vector2.new(cx + bW/2, headScreen.Y); bL.Right.To = Vector2.new(cx + bW/2, feetScreen.Y)
            bL.Bottom.From = Vector2.new(cx + bW/2, feetScreen.Y); bL.Bottom.To = Vector2.new(cx - bW/2, feetScreen.Y)
            bL.Left.From = Vector2.new(cx - bW/2, feetScreen.Y); bL.Left.To = Vector2.new(cx - bW/2, headScreen.Y)
            for _, l in pairs(bL) do l.Visible = true end
        else
            for _, l in pairs(sL) do l.Visible = false end
            for _, l in pairs(bL) do l.Visible = false end
        end

        if Config.HealthbarESP then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local fillH = bH * pct
            hBg.From = Vector2.new(barX, headScreen.Y)
            hBg.To = Vector2.new(barX, feetScreen.Y)
            hBg.Visible = true

            local segH = fillH / SEGS
            for i, seg in ipairs(hSegs) do
                local segBot = feetScreen.Y - (i-1)*segH
                local segTop = feetScreen.Y - i*segH
                seg.From = Vector2.new(barX, segTop)
                seg.To = Vector2.new(barX, segBot)
                seg.Visible = true
            end
        else
            hBg.Visible = false
            for _, s in ipairs(hSegs) do s.Visible = false end
        end

        if Config.NameESP then
            nameLabel.Position = Vector2.new(cx, headScreen.Y - 16)
            nameLabel.Visible = true
        else
            nameLabel.Visible = false
        end

        local lvlVal, xpVal = GetStats()
        if Config.LevelESP then
            levelLabel.Text = lvlVal and ("Level " .. tostring(lvlVal.Value)) or "Level ?"
            levelLabel.Position = Vector2.new(cx, feetScreen.Y + 5)
            levelLabel.Visible = true
        else
            levelLabel.Visible = false
        end

        if Config.XpESP then
            xpLabel.Text = xpVal and ("XP " .. tostring(xpVal.Value)) or "XP ?"
            xpLabel.Position = Vector2.new(cx, feetScreen.Y + 19)
            xpLabel.Visible = true
        else
            xpLabel.Visible = false
        end
    end)

    if activeConnections[plr] then activeConnections[plr]() end
    activeConnections[plr] = function()
        if conn then conn:Disconnect() end
        Cleanup()
    end
end


