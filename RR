    do
        local function Unwrap(Item)
            if type(Item) == "table" then
                return rawget(Item, "Instance")
            end
            return Item
        end

        local function EnsureLoop()
            if Library.PhysicsConnection then return end
            Library.PhysicsConnection = RunService.RenderStepped:Connect(function(dt)
                local Step = MathMin(dt, 0.033)

                for Gui, State in pairs(Library.PhysicsPositions) do
                    if not Gui or not Gui.Parent then
                        Library.PhysicsPositions[Gui] = nil
                        continue
                    end
                    local Force = (State.Target - State.Position) * State.Stiffness - State.Velocity * State.Damping
                    State.Velocity += Force * Step
                    State.Position += State.Velocity * Step
                    Gui.Position = UDim2New(0, State.Position.X, 0, State.Position.Y)

                    if MathAbs(State.Target.X - State.Position.X) < 0.08
                        and MathAbs(State.Target.Y - State.Position.Y) < 0.08
                        and MathAbs(State.Velocity.X) < 0.08
                        and MathAbs(State.Velocity.Y) < 0.08 then
                        State.Position = State.Target
                        State.Velocity = Vector2New(0, 0)
                        Gui.Position = UDim2New(0, State.Target.X, 0, State.Target.Y)
                    end
                end

                for Gui, State in pairs(Library.PhysicsScales) do
                    if not Gui or not Gui.Parent or not State.Scale or not State.Scale.Parent then
                        Library.PhysicsScales[Gui] = nil
                        continue
                    end
                    local Force = (State.Target - State.Value) * State.Stiffness - State.Velocity * State.Damping
                    State.Velocity += Force * Step
                    State.Value += State.Velocity * Step
                    State.Scale.Scale = State.Value
                    if MathAbs(State.Target - State.Value) < 0.0005 and MathAbs(State.Velocity) < 0.0005 then
                        State.Value = State.Target
                        State.Velocity = 0
                        State.Scale.Scale = State.Target
                    end
                end

                for Gradient, State in pairs(Library.PhysicsGradients) do
                    if not Gradient or not Gradient.Parent then
                        Library.PhysicsGradients[Gradient] = nil
                        continue
                    end
                    local Force = (State.Target - State.Value) * State.Stiffness - State.Velocity * State.Damping
                    State.Velocity += Force * Step
                    State.Value += State.Velocity * Step
                    Gradient.Rotation = State.Value % 360
                    if MathAbs(State.Target - State.Value) < 0.02 and MathAbs(State.Velocity) < 0.02 then
                        State.Value = State.Target
                        State.Velocity = 0
                        Gradient.Rotation = State.Target % 360
                    end
                end
            end)
        end

        function Library:SetPhysicsPosition(Item, Target, Stiffness, Damping, StartPosition)
            local Gui = Unwrap(Item)
            if not Gui or not Gui.Parent then return end
            EnsureLoop()
            local TargetPosition = Vector2New(Target.X.Offset, Target.Y.Offset)
            local State = Library.PhysicsPositions[Gui]
            if not State then
                local Start = StartPosition and Vector2New(StartPosition.X.Offset, StartPosition.Y.Offset)
                    or Vector2New(Gui.Position.X.Offset, Gui.Position.Y.Offset)
                State = {
                    Position = Start,
                    Velocity = Vector2New(0, 0),
                    Target = TargetPosition,
                    Stiffness = Stiffness or 280,
                    Damping = Damping or 32
                }
                Library.PhysicsPositions[Gui] = State
            else
                State.Target = TargetPosition
                if Stiffness then State.Stiffness = Stiffness end
                if Damping then State.Damping = Damping end
            end
            return State
        end

        function Library:ClearPhysicsPosition(Item)
            local Gui = Unwrap(Item)
            if not Gui then return end
            Library.PhysicsPositions[Gui] = nil
        end

        function Library:SetPhysicsScale(Item, Target, Stiffness, Damping)
            local Gui = Unwrap(Item)
            if not Gui or not Gui.Parent then return end
            EnsureLoop()
            local Scale = Gui:FindFirstChild("PhysicsScale")
            if not Scale then
                Scale = InstanceNew("UIScale")
                Scale.Name = "PhysicsScale"
                Scale.Scale = 1
                Scale.Parent = Gui
            end
            local State = Library.PhysicsScales[Gui]
            if not State then
                State = {
                    Scale = Scale,
                    Value = Scale.Scale,
                    Velocity = 0,
                    Target = Target or 1,
                    Stiffness = Stiffness or 300,
                    Damping = Damping or 32
                }
                Library.PhysicsScales[Gui] = State
            else
                State.Target = Target or 1
                if Stiffness then State.Stiffness = Stiffness end
                if Damping then State.Damping = Damping end
            end
            return State
        end

        function Library:SetPhysicsGradient(Gradient, TargetRotation, Stiffness, Damping)
            Gradient = Unwrap(Gradient)
            if not Gradient or not Gradient:IsA("UIGradient") or not Gradient.Parent then return end
            EnsureLoop()
            local State = Library.PhysicsGradients[Gradient]
            if not State then
                State = {
                    Value = Gradient.Rotation,
                    Velocity = 0,
                    Target = TargetRotation or Gradient.Rotation,
                    Stiffness = Stiffness or 82,
                    Damping = Damping or 16
                }
                Library.PhysicsGradients[Gradient] = State
            else
                State.Target = TargetRotation or State.Target
                if Stiffness then State.Stiffness = Stiffness end
                if Damping then State.Damping = Damping end
            end
            return State
        end

        function Library:MakePhysicsDraggable(Item, Handle, Options)
            local Gui = Unwrap(Item)
            local DragHandle = Unwrap(Handle) or Gui
            if not Gui or not DragHandle or not Gui.Parent then return end
            Options = Options or {}

            local Dragging = false
            local PointerStart = Vector2New(0, 0)
            local StartPosition = Vector2New(0, 0)
            local TargetPosition = Vector2New(0, 0)
            local CurrentPosition = Vector2New(0, 0)
            local Velocity = Vector2New(0, 0)
            local Rotation = 0
            local RotationVelocity = 0

            local function IsCenterAnchored()
                return Gui.AnchorPoint.X == 0.5 and Gui.AnchorPoint.Y == 0.5
            end

            local function CurrentGuiPosition()
                if IsCenterAnchored() then
                    return Vector2New(
                        Gui.AbsolutePosition.X + Gui.AbsoluteSize.X * 0.5,
                        Gui.AbsolutePosition.Y + Gui.AbsoluteSize.Y * 0.5
                    )
                end
                return Vector2New(Gui.AbsolutePosition.X, Gui.AbsolutePosition.Y)
            end

            local function Bounds()
                local ParentSize = Gui.Parent.AbsoluteSize
                local Size = Gui.AbsoluteSize
                if IsCenterAnchored() then
                    local Half = Size * 0.5
                    return Half.X, ParentSize.X - Half.X, Half.Y, ParentSize.Y - Half.Y
                end
                return 0, MathMax(0, ParentSize.X - Size.X), 0, MathMax(0, ParentSize.Y - Size.Y)
            end

            local function IsPointer(Input)
                return Input.UserInputType == Enum.UserInputType.MouseButton1
                    or Input.UserInputType == Enum.UserInputType.Touch
            end

            Library:Connect(DragHandle.InputBegan, function(Input)
                if not IsPointer(Input) then return end
                Dragging = true
                PointerStart = Vector2New(Input.Position.X, Input.Position.Y)
                StartPosition = CurrentGuiPosition()
                CurrentPosition = StartPosition
                TargetPosition = StartPosition
                Velocity = Vector2New(0,0)
                RotationVelocity = 0
            end)

            Library:Connect(UserInputService.InputEnded, function(Input)
                if not IsPointer(Input) then return end
                if Dragging then
                    Dragging = false
                end
            end)

            Library:Connect(UserInputService.InputChanged, function(Input)
                if not Dragging then return end
                if Input.UserInputType ~= Enum.UserInputType.MouseMovement
                    and Input.UserInputType ~= Enum.UserInputType.Touch then return end
                local Pointer = Vector2New(Input.Position.X, Input.Position.Y)
                local Delta = Pointer - PointerStart
                TargetPosition = StartPosition + Delta
                local MinX, MaxX, MinY, MaxY = Bounds()
                TargetPosition = Vector2New(
                    MathClamp(TargetPosition.X, MinX, MaxX),
                    MathClamp(TargetPosition.Y, MinY, MaxY)
                )
            end)

            Library:Connect(RunService.RenderStepped, function(dt)
                if not Gui.Parent then return end
                local Step = MathMin(dt, 0.033)
                local Stiffness = Options.Stiffness or 420
                local Damping = Options.Damping or 39
                local Force = (TargetPosition - CurrentPosition) * Stiffness - Velocity * Damping
                Velocity += Force * Step
                CurrentPosition += Velocity * Step

                local MinX, MaxX, MinY, MaxY = Bounds()
                CurrentPosition = Vector2New(
                    MathClamp(CurrentPosition.X, MinX, MaxX),
                    MathClamp(CurrentPosition.Y, MinY, MaxY)
                )
                TargetPosition = Vector2New(
                    MathClamp(TargetPosition.X, MinX, MaxX),
                    MathClamp(TargetPosition.Y, MinY, MaxY)
                )

                Gui.Position = UDim2New(0, CurrentPosition.X, 0, CurrentPosition.Y)

                local WantedRotation = MathClamp(Velocity.X * (Options.RotationStrength or 0.006), -1.6, 1.6)
                local RotForce = (WantedRotation - Rotation) * 78 - RotationVelocity * 18
                RotationVelocity += RotForce * Step
                Rotation += RotationVelocity * Step
                Gui.Rotation = Rotation
            end)
        end
    end

    Library.MakeBlurred = function(self, Item, Window)
        Item = Item.Instance
        local BlurItem = Item
        local Part = Instances:Create("Part", {
            Material = Enum.Material.Glass,
            Transparency = 1,
            Reflectance = 1,
            CastShadow = false,
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CollisionGroup = " ",
            Size = Vector3New(1, 1, 1) * 0.01,
            Color = FromRGB(0,0,0),
            Parent = Camera
        })
        local BlockMesh = Instances:Create("BlockMesh", {Parent = Part.Instance})
        local DepthOfField = Instances:Create("DepthOfFieldEffect", {
            Parent = Lighting,
            Enabled = Library.BlurEnabled,
            FarIntensity = 0,
            FocusDistance = 0,
            InFocusRadius = 1000,
            NearIntensity = 1,
            Name = ""
        })
        Library:Connect(RunService.RenderStepped, function()
            if Library.BlurEnabled and Window.IsOpen then
                if Item.Visible then
                    DepthOfField:Tween(nil, {NearIntensity = 1})
                    Part:Tween(nil, {Transparency = 0.97})
                    Part:Tween(nil, {Size = Vector3New(1, 1, 1) * 0.01})
                    local Corner0 = BlurItem.AbsolutePosition
                    local Corner1 = Corner0 + BlurItem.AbsoluteSize
                    local Ray0 = Camera.ScreenPointToRay(Camera, Corner0.X, Corner0.Y, 1)
                    local Ray1 = Camera.ScreenPointToRay(Camera, Corner1.X, Corner1.Y, 1)
                    local Origin = Camera.CFrame.Position + Camera.CFrame.LookVector * (0.05 - Camera.NearPlaneZ)
                    local Normal = Camera.CFrame.LookVector
                    local Position0 = Library:GetCalculatedRayPosition(Origin, Normal, Ray0.Origin, Ray0.Direction)
                    local Position1 = Library:GetCalculatedRayPosition(Origin, Normal, Ray1.Origin, Ray1.Direction)
                    Position0 = Camera.CFrame:PointToObjectSpace(Position0)
                    Position1 = Camera.CFrame:PointToObjectSpace(Position1)
                    local Size = Position1 - Position0
                    local Center = (Position0 + Position1) / 2
                    BlockMesh.Instance.Offset = Center
                    BlockMesh.Instance.Scale  = Size / 0.0101
                    Part.Instance.CFrame = Camera.CFrame
                else
                    DepthOfField:Tween(nil, {NearIntensity = 0})
                    BlockMesh.Instance.Offset = Vector3New(0, 0, 0)
                    BlockMesh.Instance.Scale  = Vector3New(0, 0, 0)
                end
            else
                DepthOfField:Tween(nil, {NearIntensity = 0})
                BlockMesh.Instance.Offset = Vector3New(0, 0, 0)
                BlockMesh.Instance.Scale  = Vector3New(0, 0, 0)
            end
        end)
    end

    Library.EscapePattern = function(self, String)
        local ShouldEscape = false
        if string.match(String, "[%(%)%.%%%+%-%*%?%[%]%^%$]") then
            ShouldEscape = true
        end
        if ShouldEscape then
            return StringGSub(String, "[%(%)%.%%%+%-%*%?%[%]%^%$]", "%%%1")
        end
        return String
    end

