    local Last = 0
    local LastFrame = 1 / 60

    local function UpdateMetrics(dt)

        Last += dt

        if Last < 0.08 then
            return
        end

        Last = 0

        local FrameTime =
            MathClamp(
                LastFrame,
                1 / 240,
                0.25
            )

        local FPS =
            1 / FrameTime

        local Ping = 0

        pcall(function()

            if LocalPlayer
                and LocalPlayer.GetNetworkPing then

                Ping =
                    LocalPlayer:GetNetworkPing()
                    * 1000
            end
        end)

        local Memory = 0

        pcall(function()

