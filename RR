            )
    end





    local CurrentBlur = 0

    local function SetBlurEnabled(Enabled)

        if Enabled then
            PerformanceBlur.Enabled = true
        end

        local TargetBlur =
            Enabled and 7 or 0

        CurrentBlur +=
            (TargetBlur - CurrentBlur) * 0.18

        PerformanceBlur.Size =
            MathFloor(CurrentBlur + 0.5)

        if not Enabled
            and CurrentBlur <= 0.5 then

            CurrentBlur = 0
            PerformanceBlur.Size = 0
            PerformanceBlur.Enabled = false
        end
    end





    local Connection =
        RunService.RenderStepped:Connect(
            function(dt)

                if not Overlay.Instance.Parent then

                    PerformanceBlur.Enabled = false

                    return
                end


                if Drag.Position.X == 0 then

                    local Size =
                        Overlay.Instance.Parent.AbsoluteSize

                    Drag.Position =
                        Vector2New(
                            Size.X * 0.5,
                            8
                        )

                    Drag.Target =
                        Drag.Position
                end

                LastFrame = dt

                local Step =
                    MathMin(dt, 0.033)





                local Force =
                    (Drag.Target - Drag.Position)
                    * 300
                    - Drag.Velocity * 36

                Drag.Velocity +=
                    Force * Step

                Drag.Position +=
                    Drag.Velocity * Step

                Overlay.Instance.Position =
                    UDim2New(
                        0,
                        Drag.Position.X,
                        0,
                        Drag.Position.Y
                    )





                local WantedRotation =
                    MathClamp(
                        Drag.Velocity.X * 0.0065,
                        -2.0,
                        2.0
                    )

                local RotForce =
                    (WantedRotation - Drag.Rotation)
                    * 70
                    - Drag.RotationVelocity * 16

                Drag.RotationVelocity +=
                    RotForce * Step

                Drag.Rotation +=
                    Drag.RotationVelocity * Step

                Overlay.Instance.Rotation =
                    Drag.Rotation





                local Speed =
                    Drag.Velocity.Magnitude

                local WantedScale =
                    1 +
                    MathClamp(
                        Speed * 0.00006,
                        0,
                        0.01
                    )

                local ScaleForce =
                    (WantedScale - Drag.Scale)
                    * 95
                    - Drag.ScaleVelocity * 16

                Drag.ScaleVelocity +=
                    ScaleForce * Step

                Drag.Scale +=
                    Drag.ScaleVelocity * Step

                Scale.Scale =
                    Drag.Scale





                UpdateMetrics(dt)





                local ShouldBlur =
                    Library.BlurEnabled
                    and Window.IsOpen
                    and not Window.MiniMode

                SetBlurEnabled(ShouldBlur)
            end
        )





    table.insert(
        Library.PerformanceOverlays,
        {
            Gui = Overlay.Instance,
            Connection = Connection,
            BlurEffect = PerformanceBlur
        }
    )

