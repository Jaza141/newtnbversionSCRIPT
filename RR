    Library.Unload = function(self)
        for Index, Value in self.Connections do if Value.Connection then Value.Connection:Disconnect() end end
        for _, MusicPlayer in ipairs(self.MusicPlayers or {}) do
            pcall(function() MusicPlayer:Destroy() end)
        end
        if self.BlurEnforcer then pcall(function() self.BlurEnforcer:Disconnect() end) end
        self.BlurEnforcer = nil
        for _, OverlayData in ipairs(self.PerformanceOverlays or {}) do
            if OverlayData.Connection then pcall(function() OverlayData.Connection:Disconnect() end) end
        end
        if self.PhysicsConnection then pcall(function() self.PhysicsConnection:Disconnect() end) end
        for Index, Value in self.Threads do pcall(function() coroutine.close(Value) end) end
        if self.Holder then self.Holder:Clean() end
        Library = nil
        getgenv().Library = nil
    end

