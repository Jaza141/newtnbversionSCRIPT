        end

        task.spawn(function()

            local TweenService = game:GetService("TweenService")
            local Players = game:GetService("Players")
            local PathfindingService = game:GetService("PathfindingService")
            local RunService = game:GetService("RunService")

            local player = Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")
            local humanoid = character:WaitForChild("Humanoid")

            local constructionJob = workspace:WaitForChild("ConstructionJob")
            local houseModel = constructionJob:WaitForChild("Plot"):WaitForChild("House")
            local materialsFolder = constructionJob:WaitForChild("Materials")

            local WALK_SPEED = 19.676469802856445
            local activeTween = nil




            local actionCooldown = false

            local function cooldown()
                actionCooldown = true
                task.delay(0.5, function()
                    actionCooldown = false
                end)
            end




            RunService.Heartbeat:Connect(function()
                if getgenv().ConstructionFarm and humanoid then
                    humanoid.WalkSpeed = WALK_SPEED
                end
            end)




            RunService.Stepped:Connect(function()
                if not getgenv().ConstructionFarm then return end

                for _, v in ipairs(character:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = false
                    end
                end
            end)




            local function tweenTo(position)

                if activeTween then
                    activeTween:Cancel()
                end

                local dist = (hrp.Position - position).Magnitude
                if dist < 1 then return end

                local duration = dist / WALK_SPEED

                local tween = TweenService:Create(
                    hrp,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear),
                    {CFrame = CFrame.new(position)}
                )

                activeTween = tween
                tween:Play()
                tween.Completed:Wait()
            end




            local function pathfindTo(position)

                local path = PathfindingService:CreatePath({
                    AgentRadius = 4,
                    AgentHeight = 6,
                    AgentCanJump = true,
                    AgentJumpHeight = 10,
                    AgentMaxSlope = 40,
                    WaypointSpacing = 10
                })

                pcall(function()
                    path:ComputeAsync(hrp.Position, position)
                end)

                if path.Status ~= Enum.PathStatus.Success then
                    humanoid:MoveTo(position)
                    task.wait(0.2)
                    return
                end

                for _, waypoint in ipairs(path:GetWaypoints()) do

                    if getgenv().ConstructionFarm == false then
                        return
                    end

                    if waypoint.Action == Enum.PathWaypointAction.Jump then
                        humanoid.Jump = true
                    end

                    humanoid:MoveTo(waypoint.Position)

                    local start = tick()

                    while getgenv().ConstructionFarm do

                        if (hrp.Position - waypoint.Position).Magnitude < 4 then
                            break
                        end

                        if tick() - start > 1.2 then
                            break
                        end

                        task.wait(0.05)
                    end
                end
            end




            local function moveTo(position)

                if getgenv().ConstructionFarmMode == "Pathfinding [Beta]" then
                    pathfindTo(position)
                else
                    tweenTo(position)
                end
            end




            local function firePrompt(prompt, part)

                if not prompt or not part then return end
                if actionCooldown then return end

                local pos = part.Position + (part.CFrame.LookVector * -3)

                moveTo(Vector3.new(pos.X, hrp.Position.Y, pos.Z))

                task.wait(0.1)

                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 999
                prompt.RequiresLineOfSight = false

                fireproximityprompt(prompt)

                task.wait(0.25)

                cooldown()
            end




            local function equipFirstTool()

                local backpack = player:FindFirstChild("Backpack")
                if not backpack then return end

                local tool = backpack:FindFirstChildWhichIsA("Tool")
                if tool then
                    humanoid:EquipTool(tool)
                    task.wait(0.15)
                end
            end




            local function findEnabledPlotPrompt()

                for i = 1, 12 do
                    local folder = houseModel:FindFirstChild("Part"..i)
                    if folder then
                        for _, part in ipairs(folder:GetChildren()) do
                            local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
                            if prompt and prompt.Enabled then
                                return part, prompt
                            end
                        end
                    end
                end

                return nil, nil
            end




            local function findMaterialPrompt(materialName)

                local model = materialsFolder:FindFirstChild(materialName)
                if not model then return nil, nil end

                local closestPart, closestPrompt, closestDist = nil, nil, math.huge

                for _, obj in ipairs(model:GetDescendants()) do
                    if obj:IsA("BasePart") then

                        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")

                        if prompt then
                            local dist = (hrp.Position - obj.Position).Magnitude

                            if dist < closestDist then
                                closestDist = dist
                                closestPart = obj
                                closestPrompt = prompt
                            end
                        end
                    end
                end

                return closestPart, closestPrompt
            end




            local function getHeldToolName()

                local equipped = character:FindFirstChildWhichIsA("Tool")
                if equipped then return equipped.Name end

                local backpack = player:FindFirstChild("Backpack")
                if backpack then
                    local tool = backpack:FindFirstChildWhichIsA("Tool")
                    if tool then return tool.Name end
                end

                return nil
            end

            local function hasTool()
                if character:FindFirstChildWhichIsA("Tool") then return true end
                local backpack = player:FindFirstChild("Backpack")
                return backpack and backpack:FindFirstChildWhichIsA("Tool")
            end




            while getgenv().ConstructionFarm do

                pcall(function()

                    if actionCooldown then return end

                    local plotPart, plotPrompt = findEnabledPlotPrompt()
                    if not plotPart or not plotPrompt then return end

                    local neededMaterial = plotPart.Name
                    local currentTool = getHeldToolName()


                    if currentTool ~= neededMaterial then

                        local matPart, matPrompt = findMaterialPrompt(neededMaterial)
                        if not matPart or not matPrompt then return end

                        if hasTool() then
                            firePrompt(matPrompt, matPart)
                            task.wait(0.3)
                            firePrompt(matPrompt, matPart)
                        else
                            firePrompt(matPrompt, matPart)
                        end

                        equipFirstTool()
                        task.wait(0.2)
                    end


                    local freshPart, freshPrompt = findEnabledPlotPrompt()

                    if freshPart
                        and freshPrompt
                        and freshPart.Name == neededMaterial then

                        firePrompt(freshPrompt, freshPart)
                        task.wait(0.2)

                        if freshPrompt.Enabled then
                            firePrompt(freshPrompt, freshPart)
                        end

                        cooldown()
                    end

                end)

                task.wait(0.08)
            end
        end)
    end
})



AutofarmSection:Toggle({
