            Player.Items.Pause = Pause
            Player.Items.Next = Next

            local function SetState(TextValue)
                State.Instance.Text = TextValue
            end

            local function UpdateTrackText(TitleText)
                Track.Instance.Text = tostring(Player.Index) .. " / " .. tostring(#Player.Links) .. "  " .. tostring(TitleText or ("Track " .. tostring(Player.Index)))
            end

            function Player:StopSound()
                if self.Sound then
                    pcall(function() self.Sound:Stop() end)
                    pcall(function() self.Sound:Destroy() end)
                    self.Sound = nil
                end
                self.Paused = false
                self.Items.Pause.Instance.Text = "II"
            end

            function Player:Load(Index, PlayNow)
                if self.Loading then return end
                Index = ((tonumber(Index) or 1) - 1) % #self.Links + 1
                self.Loading = true
                self:StopSound()
                self.Index = Index
                UpdateTrackText("Loading...")
                SetState("Downloading")
                local Asset, TitleText, Err = DownloadTrack(Index)
                if not Asset then
                    UpdateTrackText("Track " .. tostring(Index))
                    SetState(Err or "Unable to load")
                    self.Loading = false
                    return
                end
                local Sound = InstanceNew("Sound")
                Sound.Name = "MusicPlayerTrack"
                Sound.SoundId = Asset
                Sound.Volume = self.Volume
                Sound.Looped = self.Looped
                Sound.Parent = SoundService
                self.Sound = Sound
                self.Paused = not PlayNow
                UpdateTrackText(TitleText)
                SetState(PlayNow and "Playing" or "Paused")
                self.Items.Pause.Instance.Text = PlayNow and "II" or ">"
                if PlayNow then
                    local Played = pcall(function() Sound:Play() end)
                    if not Played then Sound.Playing = true end
                end
                self.Loading = false
            end

            function Player:TogglePause()
                if not self.Sound then
                    self:Load(self.Index, true)
                    return
                end
                if self.Sound.IsPlaying then
                    local Ok = pcall(function() self.Sound:Pause() end)
                    if not Ok then self.Sound.Playing = false end
                    self.Paused = true
                    SetState("Paused")
                    self.Items.Pause.Instance.Text = ">"
                else
                    local Ok = pcall(function() self.Sound:Resume() end)
                    if not Ok then self.Sound.Playing = true end
                    self.Paused = false
                    SetState("Playing")
                    self.Items.Pause.Instance.Text = "II"
                end
            end

            function Player:NextTrack()
                self:Load(self.Index + 1, true)
            end

            function Player:PreviousTrack()
                self:Load(self.Index - 1, true)
            end

            function Player:SetVolume(Value)
                self.Volume = math.clamp(tonumber(Value) or 0, 0, 10)
                if self.Sound then self.Sound.Volume = self.Volume end
            end

            function Player:Destroy()
                self:StopSound()
                for _, Connection in ipairs(self.Connections) do
                    pcall(function() Connection:Disconnect() end)
                end
                if self.Items.Root and self.Items.Root.Instance then
                    self.Items.Root:Clean()
                end
            end

            Player.Connections[#Player.Connections + 1] = Previous:Connect("MouseButton1Down", function() Player:PreviousTrack() end)
            Player.Connections[#Player.Connections + 1] = Pause:Connect("MouseButton1Down", function() Player:TogglePause() end)
            Player.Connections[#Player.Connections + 1] = Next:Connect("MouseButton1Down", function() Player:NextTrack() end)

            TableInsert(Library.MusicPlayers, Player)
            task.spawn(function() Player:Load(Player.Index, Options.Autoplay ~= false) end)
            return Player
        end

