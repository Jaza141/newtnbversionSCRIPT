    Library.SetBlurEnabled = function(self, Enabled)
        self.BlurEnabled = Enabled ~= false
        for _, Effect in ipairs(Lighting:GetChildren()) do
            if Effect:IsA("BlurEffect") or Effect:IsA("DepthOfFieldEffect") then
                if self.BlurStates[Effect] == nil then
                    self.BlurStates[Effect] = Effect.Enabled
                end
                Effect.Enabled = self.BlurEnabled and self.BlurStates[Effect] or false
            end
        end
        if not self.BlurEnforcer then
            self.BlurEnforcer = RunService.RenderStepped:Connect(function()
                for _, Effect in ipairs(Lighting:GetChildren()) do
                    if Effect:IsA("BlurEffect") or Effect:IsA("DepthOfFieldEffect") then
                        if self.BlurStates[Effect] == nil then
                            self.BlurStates[Effect] = Effect.Enabled
                        end
                        Effect.Enabled = self.BlurEnabled and self.BlurStates[Effect] or false
                    end
                end
            end)
        end
    end

