local function FireSonar()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local origin = root.Position - Vector3.new(0, root.Size.Y / 2, 0)
    local rings = {}
    for i = 1, Config.RingCount do
        rings[i] = MakeRing(origin)
    end
    local hitPlayers = {}
    local elapsed = 0
    local done = false
    local waveConn
    waveConn = RunService.Heartbeat:Connect(function(dt)
        if done then return end
        elapsed = elapsed + dt
        local leadR = elapsed * Config.SonarSpeed
        local progress = math.clamp(elapsed / 2.5, 0, 1)
        for i, ring in ipairs(rings) do
            local r = math.max(0, leadR - (i - 1) * Config.RingGap)
            if r < 1 then
                ring.part.Transparency = 1
            else
                local s = r / 2
                ring.mesh.Scale = Vector3.new(s, s, 0.07)
                ring.part.CFrame = CFrame.new(origin) * CFrame.Angles(math.pi / 2, 0, 0)
                local trailT = ((i - 1) / Config.RingCount) * 0.5
                local easedP = progress * progress
                ring.part.Transparency = math.clamp(trailT + easedP * 0.95, 0, 1)
            end
        end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and playerDots[plr] and not hitPlayers[plr] then
                local pchar = plr.Character
                local proot = pchar and pchar:FindFirstChild("HumanoidRootPart")
                if proot then
                    local flatDist = Vector2.new(
                        proot.Position.X - origin.X,
                        proot.Position.Z - origin.Z
                    ).Magnitude
                    if math.abs(flatDist - leadR) < 26 then
                        hitPlayers[plr] = true
                        playerDots[plr].alpha = 0
                        playerDots[plr].part.Transparency = 0
                    end
                end
            end
        end
        for plr in pairs(hitPlayers) do
            local data = playerDots[plr]
            if data then
                data.alpha = math.clamp(data.alpha + dt / 1.2, 0, 1)
                data.part.Transparency = data.alpha
            end
        end
        if leadR >= Config.SonarMaxRadius then
            done = true
            waveConn:Disconnect()
            for _, ring in ipairs(rings) do ring.part:Destroy() end
        end
    end)
end


