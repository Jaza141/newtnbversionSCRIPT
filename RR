    Flag = "ButchersFarm",
    Default = false,
    Callback = function(Value)

        getgenv().ButchersFarm = Value

        if not Value then
            return
        end

        task.spawn(function()

            local TweenService = game:GetService("TweenService")
            local Players = game:GetService("Players")

            local player = Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")
            local humanoid = character:WaitForChild("Humanoid")

            local butchersJob = workspace:WaitForChild("ButchersJob")

            local step2Folder = butchersJob:WaitForChild("Step2")
            local step3Folder = butchersJob:WaitForChild("Step3")
            local sellFolder = butchersJob:WaitForChild("SellMeat")

            local walkSpeed = 19.676469802856445

            local activeTween = nil
            local dodging = false
            local lastHealth = humanoid.Health




            local function isRunning()
                return getgenv().ButchersFarm == true
            end




            local function tweenTo(position)

                if not isRunning() then return false end

                if activeTween then
                    activeTween:Cancel()
                    activeTween = nil
                end

                local distance = (hrp.Position - position).Magnitude
                local duration = distance / walkSpeed

                humanoid:ChangeState(Enum.HumanoidStateType.Physics)

                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero

                local tween = TweenService:Create(
                    hrp,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear),
                    { CFrame = CFrame.new(position) }
                )

                activeTween = tween
                tween:Play()
                tween.Completed:Wait()

                if activeTween == tween then
                    activeTween = nil
                end

                humanoid:ChangeState(Enum.HumanoidStateType.Running)

                return true
            end




            local function evadeDamage()

                if dodging or not isRunning() then
                    return
                end

                dodging = true

                if activeTween then
                    activeTween:Cancel()
                    activeTween = nil
                end

                task.wait(0.1)

                local originalPos = hrp.CFrame.Position
                local undergroundPos = originalPos - Vector3.new(0, 15, 0)

                hrp.Anchored = true
                hrp.CFrame = CFrame.new(undergroundPos)

                task.wait(10)

                if not isRunning() then
                    hrp.Anchored = false
                    dodging = false
                    return
                end

                hrp.CFrame = CFrame.new(originalPos)

                task.wait(0.1)

                hrp.Anchored = false
                dodging = false
            end

            humanoid.HealthChanged:Connect(function(newHealth)
                if newHealth < lastHealth then
                    task.spawn(evadeDamage)
                end
                lastHealth = newHealth
            end)

            humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                lastHealth = humanoid.Health
            end)




            local function doPrompt(prompt, targetPart)

                if not isRunning() then return false end
                if not prompt or not targetPart then return false end

                while dodging and isRunning() do
                    task.wait()
                end

                local targetPosition =
                    targetPart.Position + (targetPart.CFrame.LookVector * -3)

                tweenTo(targetPosition)
                if not isRunning() then return false end

                while dodging and isRunning() do
                    task.wait()
                end

                task.wait(0.25)

                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 999
                prompt.RequiresLineOfSight = false
                prompt.Enabled = true

                fireproximityprompt(prompt)

                task.wait(0.5)

                return true
            end




            local function doStep2()

                local meatModel

                for _, v in ipairs(step2Folder:GetChildren()) do
                    if v.Name == "Meat" then
                        meatModel = v
                        break
                    end
                end

                if not meatModel then return false end

                local carcass = meatModel:FindFirstChild("Carcass")
                if not carcass then return false end

                local prompt = carcass:FindFirstChildWhichIsA("ProximityPrompt")
                if not prompt then return false end

                return doPrompt(prompt, carcass)
            end




            local function doStep3()

                local model = step3Folder:FindFirstChild("PlaceChopMeat")
                if not model then return false end

                local meat = model:FindFirstChild("Meat")
                if not meat then return false end

                local prompt = meat:FindFirstChildWhichIsA("ProximityPrompt")
                if not prompt then return false end

                return doPrompt(prompt, meat)
            end




            local function doSell()

                local meatSell = sellFolder:FindFirstChild("MeatSell")
                if not meatSell then return false end

                local prompt = meatSell:FindFirstChildWhichIsA("ProximityPrompt")
                if not prompt then return false end

                return doPrompt(prompt, meatSell)
            end




            while isRunning() do

                pcall(function()

                    if not isRunning() then return end
                    doStep2()
                    task.wait(1)

                    if not isRunning() then return end
                    doStep3()
                    task.wait(1)

                    if not isRunning() then return end
                    doSell()
                    task.wait(2)

                end)

                task.wait(0.1)
            end


            if activeTween then
                activeTween:Cancel()
                activeTween = nil
            end

            dodging = false
        end)
    end
})



