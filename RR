                StatsService:GetTotalMemoryUsageMb()
        end)

        Metrics.FPS.Text =
            StringFormat(
                "%d",
                MathFloor(
                    MathClamp(FPS, 0, 240)
                    + 0.5
                )
            )

        Metrics.Ping.Text =
            Ping > 0
            and StringFormat(
                "%d ms",
                MathFloor(Ping + 0.5)
            )
            or "--"

        Metrics.Memory.Text =
            StringFormat(
                "%.0f MB",
                Memory
            )

        Metrics.Frame.Text =
            StringFormat(
