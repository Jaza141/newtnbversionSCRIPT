        Library.Pages.MusicPlayer = function(self, Side, Options)
            Options = Options or {}
            if Options.Enabled == false then return nil end

            local ColumnSide = Side
            if type(ColumnSide) == "string" then
                ColumnSide = StringLower(ColumnSide) == "right" and 2 or 1
            end
            ColumnSide = tonumber(ColumnSide) or 1
            if not self.ColumnsData[ColumnSide] then ColumnSide = 1 end

            local Links = Options.Links or Options.links or Options.MusicLinks or Options.music_links or {}
            if type(Links) == "string" then Links = {Links} end
            if type(Links) ~= "table" or #Links == 0 then return nil end

            local Player = {
                Page = self,
                Side = ColumnSide,
                Links = TableClone(Links),
                Index = 1,
                Volume = tonumber(Options.Volume or Options.volume) or 3,
                Looped = Options.Looped ~= nil and Options.Looped or false,
                Sound = nil,
                Loading = false,
                Paused = false,
                Titles = {},
                Files = {},
                Connections = {},
                Items = {}
            }

            local RequestFunction = request or http_request
            if not RequestFunction and syn then RequestFunction = syn.request end

            local function DoRequest(Data)
                if RequestFunction then
                    local Ok, Result = pcall(RequestFunction, Data)
                    if Ok and Result then return Result end
                end
                local Ok, Result = pcall(function()
                    return HttpService:RequestAsync({
                        Url = Data.Url,
                        Method = Data.Method or "GET",
                        Headers = Data.Headers or {},
                        Body = Data.Body
                    })
                end)
                if Ok and Result then
                    return {StatusCode = Result.StatusCode, Body = Result.Body, Success = Result.Success}
                end
                return nil
            end

            local function GetClientId()
                if Library.SoundCloudClientId then return Library.SoundCloudClientId end
                local Ok, Html = pcall(function() return game:HttpGet("https://soundcloud.com") end)
                if not Ok or not Html then return nil end
                local Scripts = {}
                for Src in Html:gmatch('<script[^>]+src="(https://a%-v2%.sndcdn%.com/assets/[^"]+%.js)"') do
                    TableInsert(Scripts, Src)
                end
                for I = #Scripts, 1, -1 do
                    local JOk, Js = pcall(function() return game:HttpGet(Scripts[I]) end)
                    if JOk and Js and #Js > 0 then
                        local Patterns = {
                            'client_id%s*:%s*"([%w]+)"',
                            '"client_id","([%w]+)"',
                            'clientId%s*:%s*"([%w]+)"',
                            'client_id%s*=%s*"([%w]+)"'
                        }
                        for _, Pattern in ipairs(Patterns) do
                            local Id = Js:match(Pattern)
                            if Id and #Id >= 20 then
                                Library.SoundCloudClientId = Id
                                return Id
                            end
                        end
                    end
                end
                return nil
            end

            local function EnsureFolders()
                if not isfolder("Music Workspace") then makefolder("Music Workspace") end
                if not isfolder("Music Workspace/Musics") then makefolder("Music Workspace/Musics") end
                if not isfolder("Music Workspace/Configs") then makefolder("Music Workspace/Configs") end
            end

            local function DownloadTrack(Index)
                EnsureFolders()
                local Url = tostring(Player.Links[Index] or "")
                if Url == "" then return nil, nil, "Invalid SoundCloud URL" end
                local Path = "Music Workspace/Musics/track_" .. tostring(Index) .. ".mp3"
                Player.Files[Index] = Path
                if isfile(Path) then
                    local Ok, Asset = pcall(function() return getcustomasset(Path) end)
                    if Ok and Asset then
                        return Asset, Player.Titles[Index] or ("Track " .. tostring(Index)), nil
                    end
                end

                local ClientId = GetClientId()
                if not ClientId then return nil, nil, "SoundCloud client_id not found" end
                local TrackUrl = Url:match("([^?]+)") or Url
                local Resolve = DoRequest({
                    Url = "https://api-v2.soundcloud.com/resolve?url=" .. TrackUrl .. "&client_id=" .. ClientId,
                    Method = "GET",
                    Headers = {Accept = "application/json"}
                })
                if not Resolve or Resolve.StatusCode ~= 200 then
                    return nil, nil, "SoundCloud resolve failed"
                end
                local OkData, TrackData = pcall(function() return HttpService:JSONDecode(Resolve.Body) end)
                if not OkData or not TrackData then return nil, nil, "Invalid SoundCloud metadata" end

                local Policy = StringLower(tostring(TrackData.policy or ""))
                if Policy == "snipped" then return nil, nil, "Track is preview-only" end

                local StreamUrl = nil
                if TrackData.media and TrackData.media.transcodings then
                    for _, T in ipairs(TrackData.media.transcodings) do
                        if T.format and T.format.protocol == "progressive" and StringFind(StringLower(tostring(T.format.mime_type or "")), "mpeg", 1, true) then
                            StreamUrl = T.url
                            break
                        end
                    end
                    if not StreamUrl then
                        for _, T in ipairs(TrackData.media.transcodings) do
                            if T.format and T.format.protocol == "progressive" then
                                StreamUrl = T.url
                                break
                            end
                        end
                    end
                end
                if not StreamUrl then return nil, nil, "No playable SoundCloud stream" end

                local Stream = DoRequest({
                    Url = StreamUrl .. "?client_id=" .. ClientId,
                    Method = "GET",
                    Headers = {Accept = "application/json"}
                })
                if not Stream or Stream.StatusCode ~= 200 then return nil, nil, "SoundCloud stream lookup failed" end
                local OkInfo, StreamInfo = pcall(function() return HttpService:JSONDecode(Stream.Body) end)
                if not OkInfo or not StreamInfo or not StreamInfo.url then return nil, nil, "SoundCloud CDN URL missing" end

                local Audio = DoRequest({
                    Url = StreamInfo.url,
                    Method = "GET",
                    Headers = {
                        ["User-Agent"] = "Mozilla/5.0",
                        ["Content-Type"] = "application/octet-stream"
                    }
                })
                if not Audio then return nil, nil, "Audio download failed" end
                local Status = Audio.StatusCode or Audio.status or 0
                local Body = Audio.Body or Audio.body or ""
                if Status ~= 200 and Status ~= 206 then return nil, nil, "SoundCloud CDN returned HTTP " .. tostring(Status) end
                if #Body < 1000 then return nil, nil, "Downloaded audio is invalid" end
                local Saved, SaveErr = pcall(function() writefile(Path, Body) end)
                if not Saved then return nil, nil, tostring(SaveErr) end
                local OkAsset, Asset = pcall(function() return getcustomasset(Path) end)
                if not OkAsset or not Asset then return nil, nil, "getcustomasset failed" end
                local TitleText = tostring(TrackData.title or ("Track " .. tostring(Index)))
                Player.Titles[Index] = TitleText
                return Asset, TitleText, nil
